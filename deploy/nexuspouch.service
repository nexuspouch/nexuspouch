[Unit]
Description=Nexuspouch local store master
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nexuspouch
Group=nexuspouch
EnvironmentFile=-/etc/nexuspouch.env
ExecStart=/usr/local/bin/nexuspouch --root /var/lib/nexuspouch --listen :8787 --name %H
Restart=on-failure
RestartSec=3
LimitNOFILE=65535
# mDNS may need multicast; uncomment if discovery fails under hardening:
# AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
