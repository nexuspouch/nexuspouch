{
  "name": "@nexuspouch/admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.main.config.ts",
    "dev:sessions": "vite --config vite.sessions.config.ts",
    "build": "tsc --noEmit && npm run build:main && npm run build:sessions",
    "build:main": "vite build --config vite.main.config.ts",
    "build:sessions": "vite build --config vite.sessions.config.ts",
    "preview": "vite preview --config vite.main.config.ts"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^5.4.14"
  }
}
